# 複製成 .env 後可覆寫預設值

# 正式部署設 production；會拒絕預設帳密、弱密碼與短簽章金鑰。
PLC_ENVIRONMENT=development

# 正式環境：GCS bucket/prefix。檔案層級維持 rawdata/g1...、table2/g1... 與根目錄 CSV。
PLC_DATA_ROOT=gs://your-bucket/plc-data
PLC_GCS_PROJECT=your-gcp-project

# 僅 docker-compose.local.yml 使用；本機資料預設是專案上一層 output/。
DATA_ROOT=..

# 前端對外埠（瀏覽器開 http://localhost:此埠）
WEB_PORT=8080

# 登入帳密與簽章金鑰（正式使用請改掉）。預設 admin / admin0000
PLC_AUTH_USERNAME=admin
PLC_AUTH_ENGINEER_USERNAME=plc.engineer
PLC_AUTH_LEAD_USERNAME=plc.lead
PLC_AUTH_PASSWORD=admin0000
PLC_AUTH_SECRET=please-change-this-to-a-long-random-string

# Virtual PLC Runtime（使用 docker-compose.runtime.yml 時會自動啟用）
PLC_RUNTIME_ENABLED=false
PLC_SCAN_INTERVAL_SECONDS=0.2
PLC_PLANT_OPCUA_ENDPOINT=opc.tcp://plant-simulator:4840/plant-simulator/server/
PLC_PLANT_OPCUA_NAMESPACE=urn:tommy-huang:cz-plant-simulator
PLC_PLANT_API_URL=http://plant-simulator:8090
