# 複製到專案根目錄為 .env.hetzner；不可提交真實值。
PLC_AUTH_USERNAME=change-me
PLC_AUTH_ENGINEER_USERNAME=plc.engineer
PLC_AUTH_LEAD_USERNAME=plc.lead
PLC_AUTH_PASSWORD=change-me-at-least-12-characters
PLC_AUTH_SECRET=replace-with-openssl-rand-hex-32
PLC_INGOT_CACHE_SIZE=16

# 與同 VM 的 czochralski-simulator 透過 cz-industrial Docker network 通訊。
PLC_RUNTIME_ENABLED=true
PLC_SCAN_INTERVAL_SECONDS=0.2
PLC_PLANT_OPCUA_ENDPOINT=opc.tcp://plant-simulator:4840/plant-simulator/server/
PLC_PLANT_OPCUA_NAMESPACE=urn:tommy-huang:cz-plant-simulator
PLC_PLANT_API_URL=http://plant-simulator:8090

# 與 SPC 共用的 GCS service-account key。
SA_KEY_PATH=/home/tommy/spc-platform/deploy/hetzner/sa-key.json
