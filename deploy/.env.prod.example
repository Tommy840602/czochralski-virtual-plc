# 複製到專案根目錄成 .env.prod，docker compose -f docker-compose.prod.yml 會讀取。
#   cp deploy/.env.prod.example .env.prod  && 編輯

# 伺服器上資料目錄的絕對路徑（放 rawdata/ table2/ segment_summary.parquet 等，232MB）。
# PLC 與 SPC 共用同一份資料 → 兩個專案都指向這個共享路徑（唯讀掛載）。
DATA_ROOT=/srv/data

# 登入帳密（正式環境請改掉，勿用預設）
PLC_AUTH_USERNAME=admin
PLC_AUTH_PASSWORD=change-me-please

# 簽章金鑰：務必換成長隨機字串，例如： openssl rand -hex 32
PLC_AUTH_SECRET=REPLACE_WITH_openssl_rand_hex_32

# 逐點資料 LRU 快取根數（共享 VM 省記憶體，預設 16）
PLC_INGOT_CACHE_SIZE=16
